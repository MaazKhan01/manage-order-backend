{
  "ConnectionStrings": {
    "Default": ""
  },
  "PlatformBranding": {
    "ProjectName": "DM Order",
    "ProjectShortName": "DMO",
    "ProjectDescription": "A mini storefront and order manager for sellers who sell through social media.",
    "PlatformUrl": "http://localhost:3000",
    "SupportEmail": "support@example.com",
    "LogoUrl": "/brand/logo.svg",
    "FaviconUrl": "/favicon.ico"
  },
  "Frontend": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "FileStorage": {
    "Provider": "LocalDisk",
    "LocalRootPath": "App_Data/uploads",
    "PublicBaseUrl": "http://localhost:5080/media",
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "image/avif" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
