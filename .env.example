# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Real environments (Render / Railway / Azure) set these as platform environment variables instead.

# --- Database --------------------------------------------------------------
# Local PostgreSQL. Create the database once: CREATE DATABASE dmorder;
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=dmorder;Username=postgres;Password=CHANGE_ME

# Separate database used by the integration tests. It is wiped between tests — never point this at a
# database you care about.
TEST_DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=dmorder_test;Username=postgres;Password=CHANGE_ME

# --- Platform branding -----------------------------------------------------
# The SaaS product's own identity. Renaming the product is a change here, nowhere else.
PROJECT_NAME=DM Order
PROJECT_SHORT_NAME=DMO
PROJECT_DESCRIPTION=A mini storefront and order manager for sellers who sell through social media.
PLATFORM_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com

# --- Frontend / CORS -------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# --- Authentication (used from Phase 2) ------------------------------------
# Minimum 32 bytes. Generate one per environment, never reuse across environments.
JWT_SECRET=
JWT_ISSUER=dmorder-api
JWT_AUDIENCE=dmorder-web

# --- File storage ----------------------------------------------------------
# LocalDisk for development. MUST be S3 in production: an ephemeral host wipes local disk on every
# deploy, which would delete every seller's logo and product photography.
FILE_STORAGE_PROVIDER=LocalDisk
FILE_STORAGE_PUBLIC_BASE_URL=http://localhost:5080/media

# Cloudflare R2 (or MinIO / Backblaze B2 / S3). Only read when the provider is S3; the API refuses
# to start if the provider is S3 and any of the first four are missing.
#
#   ENDPOINT is the S3 *API* host:   https://<account-id>.r2.cloudflarestorage.com
#   PUBLIC_BASE_URL is what browsers fetch: the bucket's public r2.dev URL, or your custom domain.
#
# These are two different hosts. Pointing PUBLIC_BASE_URL at the API endpoint is the easy mistake -
# every image 401s - so startup rejects it explicitly.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
# R2 ignores the region but the signature needs one. Leave as auto unless using real AWS S3.
OBJECT_STORAGE_REGION=auto

# --- AI: reading pasted messages into draft orders --------------------------
# Server-side only. This value must never reach the browser and must never be committed.
#
# Leave the key empty to ship without the feature: the endpoint answers 503 and the dashboard
# hides the button. Nothing else is affected. See docs/adr/0009-ai-order-drafting.md.
CLAUDE_API_KEY=
# Optional overrides. The defaults are claude-haiku-4-5 / 2000 / 30.
CLAUDE_MODEL=


# --- Orders ----------------------------------------------------------------
# Prefix on every customer-facing order reference, e.g. OV-2026-K4P7QX. Changing it does not
# rewrite references already given out - old and new simply coexist.
ORDER_REFERENCE_PREFIX=OV

# --- Email (password reset) ------------------------------------------------
# Resend by default - swapping provider is one class against IEmailSender.
#
# Leave empty and password reset reports itself unavailable (503) rather than silently sending
# nothing. Everything else works without it. FROM_ADDRESS must be on a domain you have verified
# with the provider, or every message is rejected.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DM Order

# --- First platform admin (optional) ---------------------------------------
# The admin account is created on startup only when BOTH are set, and only if it does not already
# exist. There is deliberately no default admin password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Reverse proxy ---------------------------------------------------------
# Set to true ONLY when the API runs behind a proxy that sets X-Forwarded-For (Render, Railway,
# App Service, nginx). Without it the rate limiter sees the proxy's address and every visitor shares
# one bucket. With it set when NOT behind a proxy, any client can spoof its own address.
TRUST_FORWARDED_HEADERS=false

# --- Orders ---------------------------------------------------------------
# Prefix for the customer-facing order reference, e.g. DM-2026-K4P7QX. 2-8 letters.
# Changing it does not rewrite existing references: an order a customer already wrote down must
# keep working, so old and new prefixes coexist.
# Orders__ReferencePrefix=DM

# --- Plans -----------------------------------------------------------------
# Days of free order management for a new store. One month.
# Plans__TrialDays=30
#
# Products a store may publish without a paid subscription. Deliberately unset: the number has not
# been decided, and a guessed one would start refusing real sellers' products. Unset = unenforced.
# Plans__FreeProductLimit=

# --- Payments --------------------------------------------------------------
# No payment provider is configured, and none is implemented. IPaymentProvider is the boundary a real
# one will sit behind; UnconfiguredPaymentProvider throws on every call that would take money and
# reports IsConfigured=false so the dashboard never offers an upgrade button that cannot work.
#
# Do not add keys here until a provider has actually been chosen and implemented.
