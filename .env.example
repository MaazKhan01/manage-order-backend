# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Real environments (Render / Railway / Azure) set these as platform environment variables instead.

# --- Database --------------------------------------------------------------
# Local PostgreSQL. Create the database once: CREATE DATABASE dmorder;
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=dmorder;Username=postgres;Password=CHANGE_ME

# Separate database used by the integration tests. It is wiped between tests — never point this at a
# database you care about.
TEST_DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=dmorder_test;Username=postgres;Password=CHANGE_ME

# --- Platform branding -----------------------------------------------------
# The SaaS product's own identity. Renaming the product is a change here, nowhere else.
PROJECT_NAME=DM Order
PROJECT_SHORT_NAME=DMO
PROJECT_DESCRIPTION=A mini storefront and order manager for sellers who sell through social media.
PLATFORM_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com

# --- Frontend / CORS -------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# --- Authentication (used from Phase 2) ------------------------------------
# Minimum 32 bytes. Generate one per environment, never reuse across environments.
JWT_SECRET=
JWT_ISSUER=dmorder-api
JWT_AUDIENCE=dmorder-web

# --- File storage ----------------------------------------------------------
# LocalDisk for development. Switch to S3 before deploying: an ephemeral host wipes local disk.
FILE_STORAGE_PROVIDER=LocalDisk
FILE_STORAGE_PUBLIC_BASE_URL=http://localhost:5080/media
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

# --- AI (not used in V1) ---------------------------------------------------
# Server-side only. This value must never reach the browser.
AI_API_KEY=
AI_MODEL=

# --- First platform admin (optional) ---------------------------------------
# The admin account is created on startup only when BOTH are set, and only if it does not already
# exist. There is deliberately no default admin password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
